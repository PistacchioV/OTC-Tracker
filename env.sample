# True in development, False in production
DEBUG=True

FLASK_APP=run.py
FLASK_ENV=development

# If not provided, a random one is generated 
# SECRET_KEY=<YOUR_SUPER_KEY_HERE>

# If DB credentials (if NOT provided, or wrong values SQLite is used) 
# DB_ENGINE=mysql
# DB_HOST=localhost
# DB_NAME=appseed_db
# DB_USERNAME=appseed_db_usr
# DB_PASS=pass
# DB_PORT=3306

# Used for CDN (in production)
# No Slash at the end
ASSETS_ROOT=/static

# SOCIAL AUTH Github
# GITHUB_ID=YOUR_GITHUB_ID
# GITHUB_SECRET=YOUR_GITHUB_SECRET

# Web Push (notificações do SO com a aba fechada). OPCIONAL — se não definido,
# o recurso fica desligado e o app funciona normalmente. Gere as chaves uma vez:
#   python scripts/generate_vapid.py
# Requer HTTPS em produção. O navegador precisa estar rodando (mesmo em segundo
# plano); a rede precisa alcançar o serviço de push (Chrome/Edge -> fcm.googleapis.com).
# VAPID_PUBLIC_KEY=<gerado>
# VAPID_PRIVATE_KEY=<gerado — manter secreto>
# VAPID_SUBJECT=mailto:otc-tracker@seu-dominio.com

# Endereço ABSOLUTO da instância, usado pelos BOTÕES dos e-mails (o "Open the
# Confirmations Monitor" do Confirmations Escalation). Um link relativo não
# serve num e-mail, e o disparo automático roda numa thread sem request — não
# há como descobrir o endereço na hora. Sem esta variável vale
# http://<hostname da máquina>:8050, que é como a mesa alcança a instância de
# produção (start-prod.bat sobe a waitress na 8050).
# OTC_TRACKER_URL=http://nome-da-maquina:8050
# OTC_TRACKER_PORT=8050

# Horário (BRT) do card Confirmations Escalation. A rotina sai segunda e quinta
# (rolando para o próximo dia útil ANBIMA) e a escalação todo dia útil.
# CONF_ESCALATION_TIME=17:00

# Janela (BRT) em que os schedulers de IMPORTAÇÃO trabalham — a API de NDF, a de
# FXO e a varredura do box de commodities. O INTERVALO de cada um é o dele
# (NDF_API_POLL_MIN=20, FXO_API_POLL_MIN=60, BOX_SCAN_POLL_MIN=30); a janela só
# decide se aquele tique faz alguma coisa. As duas pontas são inclusivas.
# Um valor que não se entenda deixa a janela SEMPRE ABERTA (com aviso no log),
# nunca desliga a importação em silêncio.
# IMPORT_POLL_WINDOW=08:00-20:00

# ── Caminhos ─────────────────────────────────────────────────────────────────
# Raiz do share onde o app grava e lê tudo (confirmações, arquivos da CETIP,
# Electronic Inventory). O padrão é `I:\`, que é o que a instância do time tem —
# e que em macOS/Linux é um caminho RELATIVO. Por isso, fora do Windows, esta
# variável é OBRIGATÓRIA: o app RECUSA SUBIR com um valor relativo, em vez de
# criar em silêncio uma árvore `I:\Confirmation\...` dentro do diretório de
# trabalho (foi assim que ela apareceu na raiz do repositório).
# OTC_SHARED_DRIVE_ROOT=/Users/voce/otc-share

# DuckDB de usuários e códigos de verificação. O padrão fica dentro do pacote
# (apps/static/data/db/). Para mover o banco para fora da aplicação, aponte
# aqui — caminho RELATIVO é recusado na subida, pela mesma razão acima.
# DATABASE_PATH=/caminho/absoluto/Users_OTCTracker.db

# ── Saída para a internet (página Quotes: BCB e Yahoo) ───────────────────────
# A sessão da Athena vai com `trust_env=False` de propósito (herdar o proxy
# corporativo derrubava a conexão), mas BCB e Yahoo são hosts EXTERNOS e em boa
# parte da rede JPM só saem pelo proxy. A saída é tentada em FILA — esta
# variável, depois o proxy do sistema, depois a porta 10443, depois direto — e a
# primeira que responder fica memorizada no processo. Vazio força o direto.
# QUOTES_PROXY=http://proxy.jpmchase.net:9443
