# True in development, False in production
DEBUG=True

FLASK_APP=run.py
FLASK_ENV=development

# If not provided, a random one is generated 
# SECRET_KEY=<YOUR_SUPER_KEY_HERE>

# If DB credentials (if NOT provided, or wrong values SQLite is used) 
# DB_ENGINE=mysql
# DB_HOST=localhost
# DB_NAME=appseed_db
# DB_USERNAME=appseed_db_usr
# DB_PASS=pass
# DB_PORT=3306

# Used for CDN (in production)
# No Slash at the end
ASSETS_ROOT=/static

# SOCIAL AUTH Github
# GITHUB_ID=YOUR_GITHUB_ID
# GITHUB_SECRET=YOUR_GITHUB_SECRET

# Web Push (notificações do SO com a aba fechada). OPCIONAL — se não definido,
# o recurso fica desligado e o app funciona normalmente. Gere as chaves uma vez:
#   python scripts/generate_vapid.py
# Requer HTTPS em produção. O navegador precisa estar rodando (mesmo em segundo
# plano); a rede precisa alcançar o serviço de push (Chrome/Edge -> fcm.googleapis.com).
# VAPID_PUBLIC_KEY=<gerado>
# VAPID_PRIVATE_KEY=<gerado — manter secreto>
# VAPID_SUBJECT=mailto:otc-tracker@seu-dominio.com
