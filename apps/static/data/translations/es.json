  "about": "Acerca de",
  "about-hero-desc": "Plataforma interna para gestionar, validar y enviar operaciones OTC de Materias Primas a B3 — centralizada, trazable e integrada al flujo operativo.",
  "about-stat-contracts": "Tipos de Contrato",
  "about-stat-contracts-sub": "NDF & Opciones",
  "about-stat-integration": "Integración",
