# Resultado diário da recon de FXO + as justificativas escritas na tela. As duas
# são dado de runtime de cada instância: versionar traria a recon da máquina de
# dev para produção, e a justificativa de um trade da mesa para o repositório.
apps/static/data/cache/reconciliation/fxo/**/*.json
# Cache do batimento de CGD (um JSON por dia de posição).
apps/static/data/cache/reconciliation/cgd/**/*.json
apps/static/data/recon-fxo-comments.json

# Tickets do Support Center — dado de runtime de cada instância (o arquivo é
# criado no primeiro ticket). Versionar traria os tickets da máquina de dev
# para produção e ainda faria o contador de ID (#OTC-0001) andar para trás
# a cada pull.
apps/static/data/tickets/

# Registro de calendários da tela de feriados. O app o SEMEIA com os onze de
# sempre na primeira leitura, então versioná-lo não acrescenta nada — e traria
# um conflito de merge toda vez que alguém criasse um calendário pela tela, que
# é justamente o que reescreve o arquivo.
apps/static/data/holiday-calendars.json

# SOP local dev launcher (contém o bypass /dev-login — NUNCA versionar)
/devrun.py
devrun.py

# Runtime DuckDB (users) criado ao subir o app localmente para captura
apps/static/data/db/

# Sidecars de lock entre processos dos bancos de arquivo (database_access.py).
# O nome é `<caminho do banco>.lock`, então ele herda a extensão do banco:
# `Users_OTCTracker.db.lock` mas `db.sqlite3.lock` — um padrão `*.db.lock` só
# pegaria metade. São criados na subida, ao lado de cada banco (inclusive do
# `apps/db.sqlite3`, que é versionado), e são estado de runtime da máquina.
#
# Os dois padrões são deliberados, em vez de um `*.lock`: o `bun.lock` do
# front-end É versionado, e um curinga o varreria junto.
*.db.lock
*.sqlite3.lock
